{
  "name": "sovahoot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "wrangler d1 migrations apply sovahoot --local",
    "dev": "vite dev",
    "build": "vite build",
    "prepreview": "wrangler d1 migrations apply sovahoot --local",
    "preview": "vite preview",
    "deploy": "wrangler d1 migrations apply sovahoot --remote && wrangler deploy",
    "check": "wrangler types && vue-tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply sovahoot --local",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261101.1": true,
    "workerd@1.20261104.1": true
  }
}
